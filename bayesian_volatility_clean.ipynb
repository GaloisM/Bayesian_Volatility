    "df[\"RV_mean_22\"] = df[\"RV_1d\"].shift(1).rolling(22).mean()\n",
    "\n",
    "df[[\"SP500\", \"Ret_1d\", \"RV_1d\", \"RV_lag_1\", \"RV_mean_5\", \"RV_mean_22\"]].head(25)\n"
