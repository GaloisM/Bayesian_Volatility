   "source": [
    "for column in [\n",
    "    \"warning_ols_mean\",\n",
    "    \"warning_bayes_mean\",\n",
    "    \"warning_bayes_upper_80\",\n",
    "    \"warning_bayes_upper_95\",\n",
    "]:\n",
    "    print(\"\\n\", column)\n",
    "    print(confusion_matrix(signals_df[\"high_vol_realized\"], signals_df[column]))\n"
   ]
