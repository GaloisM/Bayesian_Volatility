    "        nu=nu,\n",
    "        mu=mu,\n",
    "        sigma=sigma,\n",
    "        observed=y_data,\n",
    "        dims=\"obs_id\",\n",
    "    )\n",
    "\n",
    "    student_idata = pm.sample(\n",
    "        draws=DRAWS,\n",
